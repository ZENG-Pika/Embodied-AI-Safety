         if n_seeds["linear"] > 0:
             linear_seed = self.get_linear_seed(start_state, goal_state)
 
+            # Experiment: customize the middle of the linear trajopt seed.
+            # This implements a seed-level interpolation idea:
+            # q_start -> q_mid + joint-space bump -> q_goal.
+            #
+            # Env:
+            #   CUROBO_MID_SEED_ENABLE=1
+            #   CUROBO_MID_SEED_JOINT=1
+            #   CUROBO_MID_SEED_AMP=0.25
+            #
+            # The bump is zero at start/end and largest in the middle.
+            if os.environ.get("CUROBO_MID_SEED_ENABLE", "1") == "1":
+                try:
+                    _joint = int(os.environ.get("CUROBO_MID_SEED_JOINT", "1"))
+                    _amp = float(os.environ.get("CUROBO_MID_SEED_AMP", "0.25"))
+
+                    if 0 <= _joint < self.dof:
+                        _h = linear_seed.shape[-2]
+                        _t = torch.linspace(
+                            0.0,
+                            1.0,
+                            _h,
+                            device=linear_seed.device,
+                            dtype=linear_seed.dtype,
+                        )
+                        _bump = torch.sin(torch.pi * _t) * _amp
+                        linear_seed[..., _joint] = linear_seed[..., _joint] + _bump
+
+                        if os.environ.get("CUROBO_MID_SEED_DEBUG", "0") == "1":
+                            print(
+                                f"[CUROBO_MID_SEED] enabled joint={_joint} amp={_amp} "
+                                f"horizon={_h} dof={self.dof}",
+                                flush=True,
+                            )
+                    else:
+                        if os.environ.get("CUROBO_MID_SEED_DEBUG", "0") == "1":
+                            print(
+                                f"[CUROBO_MID_SEED] invalid joint={_joint}, dof={self.dof}",
+                                flush=True,
+                            )
+                except Exception as _e:
+                    if os.environ.get("CUROBO_MID_SEED_DEBUG", "0") == "1":
+                        print(f"[CUROBO_MID_SEED] error={_e}", flush=True)
+
+
+
             linear_seeds = linear_seed.view(1, -1, self.action_horizon, self.dof).repeat(
                 1, n_seeds["linear"], 1, 1
             )

